{
  "name": "@mozert-studio/mozert-slider",
  "version": "1.1.1",
  "description": "Mozert Slider: a lightweight, dependency-free JavaScript slider and carousel plugin for React, Vue, jQuery and plain HTML. Touch, responsive, accessible, with thumbnail gallery, lightbox, hover magnifier, scroll-driven mode, 3D coverflow, parallax and zoom.",
  "keywords": [
    "mozert",
    "mozert-slider",
    "mozert-studio",
    "slider",
    "carousel",
    "image-slider",
    "image-carousel",
    "javascript-slider",
    "javascript-carousel",
    "slider-plugin",
    "carousel-plugin",
    "jquery-plugin",
    "vanilla-js",
    "dependency-free",
    "lightweight",
    "typescript",
    "touch-slider",
    "swipe",
    "responsive-slider",
    "responsive-carousel",
    "mobile-slider",
    "slideshow",
    "image-gallery",
    "product-gallery",
    "product-slider",
    "thumbnails",
    "lightbox",
    "image-zoom",
    "magnifier",
    "hover-zoom",
    "scroll-driven",
    "scroll-slider",
    "parallax",
    "coverflow",
    "3d-carousel",
    "3d-slider",
    "cube-effect",
    "fade-effect",
    "expanding-cards",
    "card-slider",
    "hero-slider",
    "banner-slider",
    "testimonial-slider",
    "logo-carousel",
    "marquee",
    "infinite-slider",
    "autoplay",
    "center-mode",
    "vertical-slider",
    "rtl",
    "accessible",
    "a11y",
    "lazy-loading",
    "react-slider",
    "react-carousel",
    "vue-slider",
    "vue-carousel",
    "nextjs",
    "nuxt",
    "shopify",
    "magento",
    "hyva",
    "woocommerce",
    "wordpress",
    "ecommerce"
  ],
  "author": "Mozert Studio",
  "license": "MIT",
  "main": "dist/mozert.js",
  "module": "dist/mozert.esm.mjs",
  "unpkg": "dist/mozert.min.js",
  "jsdelivr": "dist/mozert.min.js",
  "style": "dist/mozert.min.css",
  "types": "types/mozert.d.ts",
  "exports": {
    ".": {
      "types": "./types/mozert.d.ts",
      "import": "./dist/mozert.esm.mjs",
      "require": "./dist/mozert.js"
    },
    "./core": "./dist/mozert.core.js",
    "./jquery": "./dist/mozert.jquery.js",
    "./css": "./dist/mozert.min.css",
    "./theme.css": "./dist/mozert-theme.min.css",
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist",
    "types",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "directories": {
    "doc": "site",
    "test": "tests"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "test:all": "node scripts/test-all.mjs",
    "test": "node tests/run.cjs dist/mozert.min.js && node tests/extra.cjs dist/mozert.min.js && node tests/labels.cjs dist/mozert.min.js && node tests/modules.cjs dist/mozert.min.js && node tests/features.cjs dist/mozert.min.js && node tests/jquery.cjs && node tests/packages.cjs && node tests/responsive.cjs && node tests/site.cjs && node tests/preinit.cjs && node tests/consistency.cjs",
    "prepublishOnly": "npm run build",
    "site": "node scripts/site.mjs"
  },
  "homepage": "https://mozert-slider.netlify.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mozert-studio/mozert-slider.git"
  },
  "bugs": {
    "url": "https://github.com/mozert-studio/mozert-slider/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
