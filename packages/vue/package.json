{
  "name": "@mozert-studio/vue",
  "version": "1.1.1",
  "description": "Vue 3 component for Mozert Slider: a dependency-free slider and carousel with touch, responsive layouts, 3D effects, thumbnails and lightbox.",
  "license": "MIT",
  "type": "commonjs",
  "main": "index.cjs",
  "module": "index.mjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "index.mjs",
    "index.cjs",
    "index.d.ts",
    "README.md"
  ],
  "peerDependencies": {
    "vue": ">=3.3",
    "@mozert-studio/mozert-slider": ">=1.1.1"
  },
  "keywords": [
    "vue",
    "vue-slider",
    "vue-carousel",
    "vue-component",
    "vue-image-gallery",
    "mozert",
    "mozert-slider",
    "mozert-studio",
    "slider",
    "carousel",
    "image-slider",
    "touch-slider",
    "responsive-slider",
    "product-gallery",
    "lightbox",
    "typescript",
    "ssr",
    "lightweight",
    "zero-dependencies",
    "vue3",
    "vue-3",
    "composition-api",
    "nuxt",
    "nuxt3"
  ],
  "homepage": "https://mozert-slider.netlify.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mozert-studio/mozert-slider.git",
    "directory": "packages/vue"
  },
  "publishConfig": {
    "access": "public"
  }
}
