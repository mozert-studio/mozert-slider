{
  "name": "@mozert-studio/react",
  "version": "1.1.1",
  "description": "React component for Mozert Slider: a dependency-free slider and carousel with touch, responsive layouts, 3D effects, thumbnails and lightbox.",
  "license": "MIT",
  "type": "commonjs",
  "main": "index.cjs",
  "module": "index.mjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "index.mjs",
    "index.cjs",
    "index.d.ts",
    "README.md"
  ],
  "peerDependencies": {
    "react": ">=17",
    "@mozert-studio/mozert-slider": ">=1.1.1"
  },
  "keywords": [
    "react",
    "react-slider",
    "react-carousel",
    "mozert",
    "slider",
    "carousel",
    "nextjs",
    "nuxt",
    "ssr"
  ],
  "homepage": "https://mozert-slider.netlify.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mozert-studio/mozert-slider.git",
    "directory": "packages/react"
  },
  "publishConfig": {
    "access": "public"
  }
}
